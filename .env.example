# Copy this file to .env and fill in your key.
# Never commit .env to git (it is already in .gitignore).

# Qwen via Alibaba Cloud DashScope (OpenAI-compatible endpoint).
# Create an API key in your Alibaba Cloud Model Studio / DashScope console.
DASHSCOPE_API_KEY=sk-xxxx

# International endpoint (use dashscope.aliyuncs.com if your account is China region).
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Cheap model is fine for classification. Alternatives: qwen-turbo, qwen-plus
QWEN_MODEL=qwen-flash

# Optional pacing overrides (defaults shown in config.py). Smaller = safer.
# CRAWL_MIN_DELAY_S=6
# CRAWL_MAX_DELAY_S=14
# CRAWL_MAX_PAGES_PER_RUN=3
# CRAWL_DAILY_PAGE_CAP=20

# Full-profile fetch pacing (fetch command) - profile pages are the most
# scrutinized, so these are much slower than the search pacing above.
# FETCH_MIN_DELAY_S=30
# FETCH_MAX_DELAY_S=120
# CRAWL_MAX_FETCHES_PER_RUN=5
